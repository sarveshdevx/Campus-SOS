# =============================================================================
# CampusSOS — Backend Configuration Template (.env.example)
#
# Instructions:
# 1. Copy this file to `backend/.env` (or configure via environment variables).
# 2. Never commit your real `backend/.env` file to version control.
# 3. Default XAMPP on macOS credentials use user 'root' with an EMPTY password.
# =============================================================================

# --- Database Connection (MySQL / MariaDB via XAMPP) ---
# Host: Use 127.0.0.1 instead of 'localhost' to force TCP/IP networking
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=campussos
DB_USER=root
# Leave DB_PASS blank if your XAMPP MySQL root has no password (default)
DB_PASS=

# Optional macOS UNIX socket path (uncomment if TCP port 3306 is blocked):
# DB_SOCKET=/Applications/XAMPP/xamppfiles/var/mysql/mysql.sock

# --- Environment & Host Settings ---
APP_ENV=development
API_BASE_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:5173

# --- Session Security Configuration ---
# Session duration in seconds (86400 = 24 hours)
SESSION_LIFETIME=86400
# Set to 'true' only if serving over HTTPS with valid SSL certificates
SESSION_SECURE_COOKIE=false

# --- Optional Gemini AI Integration (Safety Classification & Triage) ---
# SAFETY RULE: SOS life-safety response NEVER depends on Gemini or external AI.
# Confidential cases (sexual harassment, anti-ragging) automatically bypass external AI.
# If key is omitted or disabled, backend gracefully falls back to deterministic heuristic classification.
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

